#include <zephyr/dt-bindings/i2c/i2c.h>

/ {
	aliases {
		neokey-i2c = &xiao_i2c;
	};
};

&xiao_i2c {
	status = "okay";
	/* Fast mode quarters the ~2 ms the main loop spends blocking on each LED
	 * frame, which buys headroom for the audio visualiser and reduces the
	 * pressure that overflows the serial receive ring.
	 */
	clock-frequency = <I2C_BITRATE_FAST>;
};
